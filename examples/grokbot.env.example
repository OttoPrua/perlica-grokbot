# Copy to a user-local path that is never committed.
# Hermes can also load these names from ${HERMES_HOME:-$HOME/.hermes}/.env.
#
# GROK_DISPATCH_WEBHOOK_KEY must not appear in argv, logs, git, or exceptions.
# Real endpoints are HTTPS. Loopback HTTP is a synthetic test mode only.

GROK_DISPATCH_WEBHOOK_URL=https://<dispatcher-host>/<dispatcher-path>
GROK_DISPATCH_WEBHOOK_KEY=<replace-with-local-bearer-token>

# Optional. Seconds. Client default is 30.
# GROK_DISPATCH_TIMEOUT=30

# Synthetic tests only. Never enable for a real dispatcher URL.
# GROK_DISPATCH_ALLOW_LOOPBACK_HTTP=1
